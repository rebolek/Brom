Recoil [
    Title: "PM-101 factory preset bank"
    Description: {
        9 patches in the format-neutral Brom preset text. A preset says only
        what it changes from the defaults, and the defaults are the
        original's own initial patch, so "Init" declares nothing.

        The original shipped its sounds as .rps files beside the script. Those
        were not recovered, so this bank is new: one patch for each thing the
        instrument does that the others do not -- the DCW sweep, the windowed
        sine-sync resonance, the filter, the two-wave octave modulation, the
        Mix-Ring mixer, both lines together, FinalCrusher, and the pitch and
        DPS envelopes.

        Envelopes in the bank use Sustain Step 2: segment one rises, segment
        two settles to the held level, segment three is the release.
    }
    Type: module
    Module: examples/pokuston/pm101/presets
    Imports: []
    Exports: [PM101-FACTORY-PRESET-COUNT pm101-factory-preset]
]

PM101-FACTORY-PRESET-COUNT: make i32! 9

pm101-factory-presets: make [array! [string!]] [
{Recoil-Preset [
    name: "Init"
    key: "init"
    description: "The original's own initial patch: a bright cosine-sawtooth held like an organ."
    features: [init default saw]
    version: 1
    plugin: "pm-101"
    params: []
]}
{Recoil-Preset [
    name: "CZ Brass"
    key: "cz-brass"
    description: "Sawtooth whose distortion opens with the attack and settles, the classic phase-distortion brass."
    features: [brass saw lead]
    version: 1
    plugin: "pm-101"
    params: [
        line-1-dcw: 1.0
        line-1-dcw-env-rate-1: 0.38
        line-1-dcw-env-rate-2: 0.5
        line-1-dcw-env-rate-3: 0.45
        line-1-dcw-env-level-1: 0.0
        line-1-dcw-env-level-2: 1.0
        line-1-dcw-env-level-3: 0.55
        line-1-dcw-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.28
        line-1-dca-env-rate-2: 0.55
        line-1-dca-env-rate-3: 0.42
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.8
        line-1-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Resonance Sweep"
    key: "resonance-sweep"
    description: "Sine-sync under a sawtooth window: the CZ resonance wave, swept down by its DCW envelope."
    features: [resonance sweep sync]
    version: 1
    plugin: "pm-101"
    params: [
        line-1-wave-1: 5.0
        line-1-window: 1.0
        line-1-dcw: 1.0
        line-1-dcw-env-rate-1: 0.2
        line-1-dcw-env-rate-2: 0.62
        line-1-dcw-env-rate-3: 0.45
        line-1-dcw-env-level-1: 0.0
        line-1-dcw-env-level-2: 1.0
        line-1-dcw-env-level-3: 0.25
        line-1-dcw-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.1
        line-1-dca-env-rate-2: 0.6
        line-1-dca-env-rate-3: 0.4
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.7
        line-1-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Square Bass"
    key: "square-bass"
    description: "Square an octave down through the low-pass, the cutoff envelope plucking each note."
    features: [bass square filter]
    version: 1
    plugin: "pm-101"
    params: [
        pitch-octave: -1.0
        line-1-wave-1: 2.0
        line-1-dcw: 0.7
        line-1-filter: 1.0
        line-1-cutoff: 0.75
        line-1-resonance: 0.45
        line-1-dcw-env-rate-1: 0.0
        line-1-dcw-env-rate-2: 0.5
        line-1-dcw-env-rate-3: 0.3
        line-1-dcw-env-level-1: 0.0
        line-1-dcw-env-level-2: 1.0
        line-1-dcw-env-level-3: 0.5
        line-1-dcw-env-level-4: 0.0
        line-1-cutoff-env-rate-1: 0.0
        line-1-cutoff-env-rate-2: 0.48
        line-1-cutoff-env-rate-3: 0.3
        line-1-cutoff-env-level-1: 0.0
        line-1-cutoff-env-level-2: 1.0
        line-1-cutoff-env-level-3: 0.3
        line-1-cutoff-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.0
        line-1-dca-env-rate-2: 0.55
        line-1-dca-env-rate-3: 0.28
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.85
        line-1-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Two Wave Organ"
    key: "two-wave-organ"
    description: "Sawtooth and square alternating cycle by cycle, the original's octave modulation, under a trapezoid window."
    features: [organ octave two-wave]
    version: 1
    plugin: "pm-101"
    params: [
        line-1-wave-1: 0.0
        line-1-wave-2: 3.0
        line-1-window: 3.0
        line-1-dcw: 0.6
        line-1-dca-env-rate-1: 0.15
        line-1-dca-env-rate-2: 0.4
        line-1-dca-env-rate-3: 0.35
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.9
        line-1-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Ring Bell"
    key: "ring-bell"
    description: "Mix-Ring with line two two octaves and a little up: free-running envelopes, so each strike rings out."
    features: [bell ring metallic]
    version: 1
    plugin: "pm-101"
    params: [
        mixer-mode: 4.0
        mixer-line-2-octave: 2.0
        mixer-line-2-detune: 14.0
        envelope-sustain-step: 0.0
        line-1-dcw: 0.0
        line-1-dca-env-rate-1: 0.0
        line-1-dca-env-rate-2: 0.76
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.0
        line-2-wave-1: 3.0
        line-2-dcw: 0.35
        line-2-dcw-env-rate-1: 0.0
        line-2-dcw-env-rate-2: 0.6
        line-2-dcw-env-level-1: 0.0
        line-2-dcw-env-level-2: 1.0
        line-2-dcw-env-level-3: 0.0
        line-2-dca-env-rate-1: 0.0
        line-2-dca-env-rate-2: 0.7
        line-2-dca-env-level-1: 0.0
        line-2-dca-env-level-2: 1.0
        line-2-dca-env-level-3: 0.0
    ]
]}
{Recoil-Preset [
    name: "Phase Pad"
    key: "phase-pad"
    description: "Both lines mixed and detuned, slow to open and slow to go, with a little vibrato."
    features: [pad slow detune vibrato]
    version: 1
    plugin: "pm-101"
    params: [
        mixer-mode: 2.0
        mixer-line-2-detune: 9.0
        pitch-vibrato-rate: 4.5
        pitch-vibrato-depth: 0.12
        line-1-dcw: 0.55
        line-1-dcw-env-rate-1: 0.62
        line-1-dcw-env-rate-2: 0.7
        line-1-dcw-env-rate-3: 0.62
        line-1-dcw-env-level-1: 0.0
        line-1-dcw-env-level-2: 1.0
        line-1-dcw-env-level-3: 0.6
        line-1-dcw-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.62
        line-1-dca-env-rate-2: 0.7
        line-1-dca-env-rate-3: 0.64
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.9
        line-1-dca-env-level-4: 0.0
        line-2-wave-1: 2.0
        line-2-dcw: 0.45
        line-2-dcw-env-rate-1: 0.66
        line-2-dcw-env-rate-2: 0.7
        line-2-dcw-env-rate-3: 0.62
        line-2-dcw-env-level-1: 0.0
        line-2-dcw-env-level-2: 1.0
        line-2-dcw-env-level-3: 0.5
        line-2-dcw-env-level-4: 0.0
        line-2-dca-env-rate-1: 0.64
        line-2-dca-env-rate-2: 0.7
        line-2-dca-env-rate-3: 0.64
        line-2-dca-env-level-1: 0.0
        line-2-dca-env-level-2: 1.0
        line-2-dca-env-level-3: 0.9
        line-2-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Crushed Pulse"
    key: "crushed-pulse"
    description: "Pulse through FinalCrusher: six bits, a divided rate and the waveshaper's knee."
    features: [lofi crush pulse]
    version: 1
    plugin: "pm-101"
    params: [
        finalcrusher-bits: 6.0
        finalcrusher-divider: 3.0
        finalcrusher-threshold: 0.4
        line-1-wave-1: 3.0
        line-1-dcw: 0.85
        line-1-dcw-env-rate-1: 0.0
        line-1-dcw-env-rate-2: 0.45
        line-1-dcw-env-rate-3: 0.3
        line-1-dcw-env-level-1: 0.0
        line-1-dcw-env-level-2: 1.0
        line-1-dcw-env-level-3: 0.4
        line-1-dcw-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.0
        line-1-dca-env-rate-2: 0.5
        line-1-dca-env-rate-3: 0.3
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.7
        line-1-dca-env-level-4: 0.0
    ]
]}
{Recoil-Preset [
    name: "Pitch Drop"
    key: "pitch-drop"
    description: "Triangle that falls from more than an octave above to the key: a phase-distortion zap."
    features: [percussive pitch zap]
    version: 1
    plugin: "pm-101"
    params: [
        line-1-wave-1: 6.0
        line-1-dcw: 1.0
        line-1-dps: 0.3
        line-1-pitch-env-rate-1: 0.32
        line-1-pitch-env-rate-2: 0.0
        line-1-pitch-env-rate-3: 0.0
        line-1-pitch-env-level-1: 0.92
        line-1-pitch-env-level-2: 0.5
        line-1-pitch-env-level-3: 0.5
        line-1-pitch-env-level-4: 0.5
        line-1-pitch-env-level-5: 0.5
        line-1-pitch-env-level-6: 0.5
        line-1-pitch-env-level-7: 0.5
        line-1-pitch-env-level-8: 0.5
        line-1-pitch-env-level-9: 0.5
        line-1-dps-env-rate-1: 0.0
        line-1-dps-env-rate-2: 0.45
        line-1-dps-env-rate-3: 0.2
        line-1-dps-env-level-1: 0.0
        line-1-dps-env-level-2: 1.0
        line-1-dps-env-level-3: 0.0
        line-1-dps-env-level-4: 0.0
        line-1-dca-env-rate-1: 0.0
        line-1-dca-env-rate-2: 0.52
        line-1-dca-env-rate-3: 0.3
        line-1-dca-env-level-1: 0.0
        line-1-dca-env-level-2: 1.0
        line-1-dca-env-level-3: 0.0
        line-1-dca-env-level-4: 0.0
    ]
]}
]

pm101-factory-preset: func [
    "Return one factory preset's Brom preset text by bank index."
    index [i32!] "Zero-based factory-bank index."
    return: [string!] "Borrowed preset text, empty when out of range."
] [
    if any [index < 0 index >= PM101-FACTORY-PRESET-COUNT] [return make string! ""]
    return pm101-factory-presets/:index
]
