pm101-param-module: func [
    "Return the host grouping of a PM-101 parameter."
    #export
    id [u32!] "Public parameter id."
    return: [c-string!] "Borrowed static group name."
] [
    if all [id >= 0 id < 81] [return as c-string! "DCO1"]
    if all [id >= 81 id < 162] [return as c-string! "DCO2"]
    if all [id >= 162 id < 207] [return as c-string! "Mixer"]
    if all [id >= 207 id < 213] [return as c-string! "Global"]
    return as c-string! ""
]
