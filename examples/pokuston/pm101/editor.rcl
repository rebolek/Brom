Recoil [
    Title: "PM-101 plug-in editor, declared in VID"
    Description: {
        GENERATED by tools/gen_editor.py -- edit the script and its two
        template halves, not this file.

        The layout block is a literal VID spec, which cannot loop, so the
        control declarations are produced from the same offsets core.rcl uses.
        What is written by hand here is the plug-in's half of a control and
        nothing else: what a value means, how it reads and what it resets to.
        Drag arithmetic, shift-for-fine, double-click-to-default and the
        begin/change/end gesture belong to the dialect.

        Six pages share one tab strip: the two oscillators, the mixer, and one
        page of envelope knobs for each. Choices (waves, window, filter type,
        mixer mode) are stepped knobs in the compact choice style; the core
        snaps their value and the readout names the position.

        The 2006 skin (teal on black, bitmap knobs) is not reproduced: the
        palette and knob styles come from recoil-gui, which lives outside
        this repository, so a PM-101 skin is a recoil-gui change.
    }
    Type: module
    Module: examples/pokuston/pm101/editor
    Ffi: [c-string]
    Imports: [
        gui/vid [
            actor actor-draw actor-edit actor-default actor-value actor-format
            view-context-attach view-context-detach view-context-tick
            view-select view-current-user set-face-text
        ]
        gui/widget [widget-format-number]
        examples/pokuston/pm101/editor-size [PM101-EDITOR-WIDTH PM101-EDITOR-HEIGHT]
        examples/pokuston/pm101/roles [
            PM101_ROLE_WAVE_A PM101_ROLE_WAVE_B PM101_ROLE_WINDOW
            PM101_ROLE_FILTER PM101_ROLE_RATE PM101_ROLE_LEVEL PM101_ROLE_MODE
            PM101_ROLE_TOGGLE PM101_ROLE_BITS PM101_ROLE_DIVIDER
            PM101_ROLE_DETUNE_OCTAVE PM101_ROLE_DETUNE_NOTE PM101_ROLE_DETUNE_CENT
            PM101_ROLE_VIBRATO_RATE
        ]
    ]
    Exports: [
        pm101-editor-create pm101-editor-destroy
        pm101-editor-attach pm101-editor-detach pm101-editor-tick
        pm101-editor-preset-changed
    ]
]

pm101: foreign <pm101.h> [
    get-parameter: "pm101_get_parameter" [c-pointer! u32! return: [f64!]]
    set-parameter: "pm101_set_parameter" [c-pointer! u32! f64! return: [logic!]]
    to-normalized: "pm101_parameter_to_normalized" [u32! f64! return: [f64!]]
    from-normalized: "pm101_parameter_from_normalized" [u32! f64! return: [f64!]]
    parameter-default: "pm101_parameter_default" [u32! return: [f64!]]
    parameter-role: "pm101_parameter_role" [u32! return: [i32!]]
]

pm101-host: foreign <pm101-editor.h> [
    ; These use e/user, the host-format context, rather than e/core. The core
    ; owns sound parameters but knows nothing about CLAP's preset mailbox or
    ; VST3's program parameter.
    preset-count: "pm101_editor_preset_count" [c-pointer! return: [u32!]]
    current-preset: "pm101_editor_current_preset" [c-pointer! return: [i32!]]
    preset-name: "pm101_editor_preset_name" [c-pointer! u32! return: [c-string!]]
    load-preset: "pm101_editor_load_preset" [c-pointer! u32! return: [logic!]]
]

editor-math: foreign <math.h> [
    pow: "pow" [f64! f64!] return: [f64!]
]

editor-libc: foreign <stdlib.h> [
    calloc: "calloc" [size! size! return: [c-pointer!]]
    free: "free" [c-pointer! return: [void!]]
]

pm101-editor!: make c-struct! [
    core: [c-pointer!]
    edit: [c-fn! [c-pointer! u32! f64! i32!] return: [none!]]
    user: [c-pointer!]
    context: [c-pointer!]
]

; The actor registries are module-global and append, so a host opening a
; second instance must not register a second copy of the same handlers. One
; registration serves every instance: the handlers reach their own editor
; through view-current-user rather than through having been registered per
; view.
actors-ready: make [#mutable i32!] 0

; --- the plug-in's half of a control ----------------------------------------

editor-of: func [
    "The editor whose view is being rendered, or null outside a frame."
    return: [c-pointer!] "Borrowed pm101-editor!, or null."
] [
    return view-current-user
]

on-value-of: func [
    "What a parameter currently reads, normalized."
    id [u32!] "Public parameter id."
    return: [f64!] "Normalized 0.0..1.0."
] [
    raw: editor-of
    if none? raw [return 0.0]
    e: make [#mutable pm101-editor!] as pm101-editor! raw
    return make f64! pm101/to-normalized id
        (make f64! pm101/get-parameter e/core id)
]

on-default-of: func [
    "What a double-click restores, normalized."
    id [u32!] "Public parameter id."
    return: [f64!] "Normalized 0.0..1.0."
] [
    return make f64! pm101/to-normalized id
        (make f64! pm101/parameter-default id)
]

on-edited: func [
    {One phase of a gesture. VID owns the drag and the phase ordering; what
     is left here is writing the engine and telling the host.}
    id [u32!] "Public parameter id."
    normalized [f64!] "New value in 0.0..1.0."
    phase [i32!] "ph-begin, ph-change or ph-end."
    return: [none!] "No value."
] [
    raw: editor-of
    if none? raw [return none]
    e: make [#mutable pm101-editor!] as pm101-editor! raw
    value: make f64! pm101/from-normalized id normalized
    accepted: pm101/set-parameter e/core id value
    unused accepted
    e/edit e/user id value phase
    return none
]

choice-text: func [
    "Name one position of a choice parameter."
    role [i32!] "PM101_ROLE_* of the parameter."
    index [i32!] "Position, from zero."
    return: [string!] "Owned text."
] [
    if any [role = PM101_ROLE_WAVE_A role = PM101_ROLE_WAVE_B] [
        if index = 0 [return make string! "SAW"]
        if index = 1 [return make string! "SQUARE"]
        if index = 2 [return make string! "PULSE"]
        if index = 3 [return make string! "SAW-PULSE"]
        if index = 4 [return make string! "TRIANGLE"]
        if index = 5 [return make string! "SINE SYNC"]
        return make string! "NONE"
    ]
    if role = PM101_ROLE_WINDOW [
        if index = 0 [return make string! "NONE"]
        if index = 1 [return make string! "SAW"]
        if index = 2 [return make string! "TRIANGLE"]
        if index = 3 [return make string! "TRAPEZOID"]
        return make string! "SAW-PULSE"
    ]
    if role = PM101_ROLE_FILTER [
        if index = 0 [return make string! "OFF"]
        if index = 1 [return make string! "LOW-PASS"]
        if index = 2 [return make string! "BAND"]
        if index = 3 [return make string! "NOTCH"]
        return make string! "HIGH-PASS"
    ]
    if role = PM101_ROLE_MODE [
        if index = 0 [return make string! "LINE 1"]
        if index = 1 [return make string! "LINE 2"]
        if index = 2 [return make string! "MIX"]
        if index = 3 [return make string! "RING"]
        if index = 4 [return make string! "RING 2"]
        if index = 5 [return make string! "MIX-RING"]
        return make string! "NOISE"
    ]
    if index = 0 [return make string! "OFF"]
    return make string! "ON"
]

on-shown: func [
    "Render one parameter's value the way its unit reads best."
    id [u32!] "Public parameter id."
    normalized [f64!] "Normalized 0.0..1.0."
    return: [string!] "Owned text."
] [
    value: make f64! pm101/from-normalized id normalized
    role: pm101/parameter-role id
    if any [
        role = PM101_ROLE_WAVE_A role = PM101_ROLE_WAVE_B
        role = PM101_ROLE_WINDOW role = PM101_ROLE_FILTER
        role = PM101_ROLE_MODE role = PM101_ROLE_TOGGLE
    ] [return choice-text role (as i32! value)]
    if role = PM101_ROLE_BITS [
        if value >= 25.0 [return make string! "FULL"]
        return widget-format-number value "%.0f bit"
    ]
    if role = PM101_ROLE_DIVIDER [return widget-format-number value "1/%.0f"]
    if role = PM101_ROLE_DETUNE_OCTAVE [return widget-format-number value "%+.0f oct"]
    if role = PM101_ROLE_DETUNE_NOTE [return widget-format-number value "%+.0f st"]
    if role = PM101_ROLE_DETUNE_CENT [return widget-format-number value "%+.0f ct"]
    if role = PM101_ROLE_VIBRATO_RATE [return widget-format-number value "%.2f Hz"]
    if role = PM101_ROLE_RATE [
        ; Rate r is (r + 1)^14 milliseconds: one millisecond to sixteen seconds.
        ms: make f64! editor-math/pow (value + 1.0) 14.0
        if ms >= 1000.0 [return widget-format-number (ms / 1000.0) "%.1f s"]
        return widget-format-number ms "%.0f ms"
    ]
    return widget-format-number value "%.2f"
]

; --- presets -----------------------------------------------------------------

show-preset-name: func [
    {Write the committed factory preset name, or "Init" for an edited patch.

     Loads are committed by the host format, so the button shows the index it
     requested at once and the host later pushes the committed index.}
    index [i32!] "Factory-bank index, or -1 for a non-factory state."
    return: [none!] "No value."
] [
    if index < 0 [
        set-face-text 'preset "Init"
        return none
    ]
    raw: editor-of
    if none? raw [return none]
    e: make [#mutable pm101-editor!] as pm101-editor! raw
    set-face-text 'preset
        (make string! pm101-host/preset-name e/user (as u32! index))
    return none
]

preset-step: func [
    "Move through the factory bank by one preset, wrapping at both ends."
    delta [i32!] "-1 for previous, 1 for next."
    return: [none!] "No value."
] [
    raw: editor-of
    if none? raw [return none]
    e: make [#mutable pm101-editor!] as pm101-editor! raw
    total: as i32! pm101-host/preset-count e/user
    if total <= 0 [return none]
    current: pm101-host/current-preset e/user
    next-index: ((current + delta) + total) % total
    accepted: pm101-host/load-preset e/user (as u32! next-index)
    if accepted [show-preset-name next-index]
    return none
]

on-preset-prev: func [
    "Load the factory preset before the current one."
    return: [none!] "No value."
] [
    preset-step -1
    return none
]

on-preset-next: func [
    "Load the factory preset after the current one."
    return: [none!] "No value."
] [
    preset-step 1
    return none
]

register-actors: func [
    "Register the handlers once for the whole module."
    return: [none!] "No value."
] [
    if actors-ready = 1 [return none]
    actor-edit 'edited :on-edited
    actor-default 'defaulted :on-default-of
    actor-value 'reads :on-value-of
    actor-format 'shown :on-shown
    actor 'preset-prev :on-preset-prev
    actor 'preset-next :on-preset-next
    actors-ready: 1
    return none
]

; --- entry points shared by the host-format shells --------------------------

pm101-editor-create: func [
    "Allocate an editor bound to one PM-101 core and the host's edit callback."
    #export
    :core [c-pointer!] "Borrowed PM-101 instance."
    edit [c-fn! [
        user [c-pointer!] parameter [u32!] value [f64!] phase [i32!]
        return: [none!]
    ]] "Host edit-gesture callback."
    :user [c-pointer!] "Borrowed callback state."
    return: [c-pointer!] "Owned editor, or null."
] [
    if none? core [return as c-pointer! 0]
    raw: editor-libc/calloc (as size! 1) (as size! size-of pm101-editor!)
    if none? raw [return as c-pointer! 0]
    e: make [#mutable pm101-editor!] as pm101-editor! raw
    e/core: core
    e/edit: edit
    e/user: user
    e/context: as c-pointer! 0
    return raw
]

pm101-editor-detach: func [
    "Tear the child surface down, leaving the editor reusable."
    #export
    :editor [c-pointer!] "Borrowed editor."
    return: [none!] "No value."
] [
    if none? editor [return none]
    e: make [#mutable pm101-editor!] as pm101-editor! :editor
    if none? e/context [return none]
    view-context-detach e/context
    e/context: as c-pointer! 0
    return none
]

pm101-editor-destroy: func [
    "Release an editor, detaching first if it is still attached."
    #export
    :editor [c-pointer!] "Owned editor; null is accepted."
    return: [none!] "No value."
] [
    if none? editor [return none]
    pm101-editor-detach :editor
    editor-libc/free :editor
    return none
]

pm101-editor-attach: func [
    {Declare the tabbed sheet and render it into a host parent.}
    #export
    :editor [c-pointer!] "Borrowed editor."
    :native-parent [c-pointer!] "Borrowed native parent handle."
    width [i32!] "Requested width." height [i32!] "Requested height."
    return: [logic!] "True when the surface was created."
] [
    if none? editor [return false]
    if none? native-parent [return false]
    e: make [#mutable pm101-editor!] as pm101-editor! :editor
    if not none? e/context [return false]
    ; The size is fixed: the layout is in absolute pixels, so a host asking for
    ; another size would get a mislaid editor rather than a scaled one.
    if width <> PM101-EDITOR-WIDTH [return false]
    if height <> PM101-EDITOR-HEIGHT [return false]
    register-actors

    e/context: view-context-attach [
        panel 0x0 760x560 colour panel [
            at 24x20 text "POKUSTON" font 12 colour muted
            at 24x36 text "PM-101" font 30 colour accent
            at 24x78 text "PHASE MANIPULATION DIGITAL SYNTHESIZER" font 10 colour muted
            at 470x30 button "<" 24x26 on-click 'preset-prev
            at 650x30 button ">" 24x26 on-click 'preset-next
            at 510x37 preset: text "" font 12 colour accent
            at 24x96 tabs 712x26
            page "DCO 1" [
            at 24x120 text "DCO 1" font 14 colour accent
            at 24x140 text "PHASE-DISTORTED OSCILLATOR LINE" font 9 colour muted
            at 30x176 across
            knob "WAVE A" radius 30 style kapralova-choice param 0
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "WAVE B" radius 30 style kapralova-choice param 1
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "WINDOW" radius 30 style kapralova-choice param 2
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "FILTER" radius 30 style kapralova-choice param 5
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            at 30x330 across
            knob "DCW" radius 36 style mach param 3
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "DPS" radius 36 style mach param 4
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "CUTOFF" radius 36 style mach param 6
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "RESONANCE" radius 36 style mach param 7
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "DCA" radius 36 style mach param 8
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            at 24x470 text "DCW BENDS THE PHASE  DPS STRETCHES IT  WAVE B ALTERNATES WITH WAVE A EACH CYCLE" font 9 colour muted
            ]
            page "DCO 2" [
            at 24x120 text "DCO 2" font 14 colour accent
            at 24x140 text "PHASE-DISTORTED OSCILLATOR LINE" font 9 colour muted
            at 30x176 across
            knob "WAVE A" radius 30 style kapralova-choice param 81
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "WAVE B" radius 30 style kapralova-choice param 82
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "WINDOW" radius 30 style kapralova-choice param 83
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "FILTER" radius 30 style kapralova-choice param 86
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            at 30x330 across
            knob "DCW" radius 36 style mach param 84
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "DPS" radius 36 style mach param 85
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "CUTOFF" radius 36 style mach param 87
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "RESONANCE" radius 36 style mach param 88
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "DCA" radius 36 style mach param 89
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            at 24x470 text "DCW BENDS THE PHASE  DPS STRETCHES IT  WAVE B ALTERNATES WITH WAVE A EACH CYCLE" font 9 colour muted
            ]
            page "MIXER" [
            at 24x120 text "MIXER" font 14 colour accent
            at 24x140 text "LINES  FILTER  DCA  FINALCRUSHER" font 9 colour muted
            at 30x176 across
            knob "MODE" radius 30 style kapralova-choice param 162
            on-edit 'edited on-default 'defaulted on-value 'reads on-format 'shown
            knob "FILTER" radius 30 style kapralova-choice param 163
