Recoil [
    Title: "PM-101 format-neutral plug-in contract"
    Description: {
        Owns the engine descriptor, the host parameter schema, the state
        contract and the factory bank shared by CLAP, VST3 and AUv2. The
        synthesis stays in core.rcl and the parameter names in param-names.rcl.

        Ranges are not restated here: core.rcl states each one once, and this
        file asks. A parameter's taper follows from its role there -- choices
        are stepped, the vibrato rate is skewed, everything else is linear in
        engineering units.
    }
    Type: module
    Module: examples/pokuston/pm101/plugin
    Ffi: [c-string]
    Imports: [
        brom/plugin/engine [engine! param-info!]
        brom/plugin/preset [
            preset-snapshot! preset-fill-buffer
            preset-factory-count preset-factory-name preset-factory-key
            preset-factory-materialize
        ]
        brom/plugin/state/dispatch [brom-state-load brom-state-save]
        brom/plugin/values [param-range! param-linear param-skewed param-stepped]
        examples/pokuston/pm101/editor-size [PM101-EDITOR-WIDTH PM101-EDITOR-HEIGHT]
        examples/pokuston/pm101/param-names [pm101-param-name pm101-param-module]
        examples/pokuston/pm101/presets [
            PM101-FACTORY-PRESET-COUNT pm101-factory-preset
        ]
        examples/pokuston/pm101/roles [PM101_ROLE_VIBRATO_RATE]
        examples/pokuston/pm101/core [
            PM101_PARAM_COUNT PM101_MAX_VOICES PM101_MAX_BLOCK
            PM101_STATE_MAGIC PM101_STATE_SCHEMA
            pm101-create pm101-destroy pm101-activate pm101-reset
            pm101-voice-state pm101-note-on pm101-note-off
            pm101-process-block pm101-output
            pm101-get-parameter pm101-set-parameter
            pm101-parameter-min pm101-parameter-max pm101-parameter-default
            pm101-parameter-role pm101-parameter-steps
            pm101-state-size pm101-save-state pm101-load-state
        ]
    ]
    Exports: [
        pm101-brom-engine
        pm101-plugin-create pm101-plugin-destroy pm101-plugin-activate
        pm101-plugin-reset pm101-plugin-voice-state
        pm101-plugin-note-on pm101-plugin-note-off
        pm101-plugin-process pm101-plugin-output
        pm101-plugin-param-info pm101-plugin-get-param pm101-plugin-set-param
        pm101-plugin-save pm101-plugin-load
        pm101-state-load pm101-state-save
    ]
]

; The BROM container's 20-byte header (8-byte universal prefix + the inner
; codec's 12-byte magic/version/count) plus eight bytes per parameter.
PM101-STATE-BYTES: 1724

math-ffi: foreign <math.h> [
    pow: "pow" [f64! f64!] return: [f64!]
]

pm101-plugin-param-info: func [
    "Describe one parameter to Brom's host shells."
    index [i32!] "Zero-based parameter index."
    :out [c-pointer!] "Borrowed caller-owned param-info! address."
    return: [logic!] "False when the index is outside the schema."
] [
    if any [index < 0 index >= PM101_PARAM_COUNT] [return false]
    id: make u32! as u32! index
    low: make f64! pm101-parameter-min id
    high: make f64! pm101-parameter-max id
    steps: pm101-parameter-steps id
    ; Linear in engineering units, so what the host draws is what the editor
    ; draws. Choices carry their position count so a host snaps them; the
    ; vibrato rate takes the same skew core.rcl maps the editor knob with.
    range: make [#mutable param-range!] param-linear low high
    if steps > 0 [range: param-stepped low high steps]
    if (pm101-parameter-role id) = PM101_ROLE_VIBRATO_RATE [
        range: param-skewed low high 0.35
    ]
    info: make [#mutable param-info!] as param-info! :out
    info/id: id
    info/name: pm101-param-name id
    info/module: pm101-param-module id
    info/default-value: make f64! pm101-parameter-default id
    info/range: range
    return true
]

; --- descriptor slots ---------------------------------------------------------

pm101-plugin-create: func [
    "Allocate a PM-101 engine instance."
    return: [c-pointer!] "Owned opaque engine state."
] [
    core: make c-pointer! pm101-create
    return core
]

pm101-plugin-destroy: func [
    "Release a PM-101 engine instance."
    :core [c-pointer!] "Borrowed opaque engine state."
    return: [none!] "No value."
] [
    pm101-destroy core
    return none
]

pm101-plugin-activate: func [
    "Prepare PM-101 for playback at a sample rate."
    :core [c-pointer!] "Borrowed opaque engine state."
    sample-rate [f64!] "Host sample rate in Hz."
    max-frames [i32!] "Largest host block; the core uses its fixed capacity."
    return: [logic!] "Always true; the core cannot fail activation."
] [
    unused max-frames
    pm101-activate :core sample-rate
    return true
]

pm101-plugin-reset: func [
    "Immediately silence voices and clear transient state while retaining parameters."
    :core [c-pointer!] "Borrowed opaque engine state."
    return: [none!] "No value."
] [pm101-reset :core]

pm101-plugin-voice-state: func [
    "Report one voice to Brom's shared allocator."
    :core [c-pointer!] "Borrowed opaque engine state."
    slot [i32!] "Voice slot to inspect."
    :out [c-pointer!] "Borrowed caller-owned voice report."
    return: [logic!] "False for an invalid slot."
] [return pm101-voice-state :core slot :out]

pm101-plugin-note-on: func [
    "Start one PM-101 voice, converting the key to a frequency."
    :core [c-pointer!] "Borrowed opaque engine state."
    slot [i32!] "Allocated voice slot."
    key [i32!] "MIDI note number."
    velocity [f64!] "Normalized note velocity."
    return: [none!] "No value."
] [
    ; Tuning is the instrument's business: the descriptor carries the MIDI key
    ; so the shared shell never has to know about equal temperament.
    freq: make f64! 440.0 * math-ffi/pow 2.0 ((key - 69) / 12.0)
    pm101-note-on :core slot freq velocity
    return none
]

pm101-plugin-note-off: func [
    "Release one PM-101 voice."
    :core [c-pointer!] "Borrowed opaque engine state."
    slot [i32!] "Voice slot to release."
    return: [none!] "No value."
] [pm101-note-off :core slot return none]

pm101-plugin-process: func [
    "Render one block into PM-101's output buffer."
    :core [c-pointer!] "Borrowed opaque engine state."
    frames [i32!] "Frames to render."
    return: [none!] "No value."
] [pm101-process-block :core frames return none]

pm101-plugin-output: func [
    "Return PM-101's mono output buffer."
    :core [c-pointer!] "Borrowed opaque engine state."
    return: [c-pointer!] "Borrowed sample buffer."
] [return pm101-output :core]

pm101-plugin-get-param: func [
    "Read one PM-101 parameter in engineering units."
    :core [c-pointer!] "Borrowed opaque engine state."
    id [u32!] "Public parameter id."
    return: [f64!] "Current engineering-unit value."
] [return pm101-get-parameter :core id]

pm101-plugin-set-param: func [
    "Write one PM-101 parameter in engineering units."
    :core [c-pointer!] "Borrowed opaque engine state."
    id [u32!] "Public parameter id."
    value [f64!] "Engineering-unit value."
    return: [logic!] "Whether the id was recognized."
] [return pm101-set-parameter :core id value]

pm101-plugin-save: func [
    "Write PM-101's fixed state envelope."
    :core [c-pointer!] "Borrowed opaque engine state."
    out [c-pointer!] "Caller-owned destination bytes."
    capacity [i32!] "Destination capacity."
    return: [logic!] "Whether the state was written."
] [
    if any [capacity < PM101-STATE-BYTES pm101-state-size <> (as size! PM101-STATE-BYTES)] [
        return false
    ]
    return pm101-save-state :core out (as size! PM101-STATE-BYTES)
]

pm101-plugin-load: func [
    "Read PM-101's fixed state envelope."
    :core [c-pointer!] "Borrowed opaque engine state."
    bytes [c-pointer!] "Borrowed state bytes."
    length [i32!] "Available byte count."
    return: [logic!] "Whether the state was accepted."
] [
    if length < PM101-STATE-BYTES [return false]
    return pm101-load-state :core bytes (as size! PM101-STATE-BYTES)
]

; --- the descriptor -----------------------------------------------------------

pm101-brom-engine: make engine! [
    id: (as c-string! "com.pokuston.pm101")
    name: (as c-string! "PM-101")
    vendor: (as c-string! "Pokuston")
    version: (as c-string! "0.5.0")
    description: (as c-string! "Sintezar PM-101: four-voice phase-manipulation synthesizer")

    param-count: PM101_PARAM_COUNT
    max-voices: PM101_MAX_VOICES
    state-size: PM101-STATE-BYTES
    output-capacity: PM101_MAX_BLOCK
    editor-width: PM101-EDITOR-WIDTH
    editor-height: PM101-EDITOR-HEIGHT
    ; Explicit: the field zero-initializes, so an editor must be declared.
    has-editor: true

    create-fn: :pm101-plugin-create
    destroy-fn: :pm101-plugin-destroy
    activate-fn: :pm101-plugin-activate
    reset-fn: :pm101-plugin-reset

    voice-state-fn: :pm101-plugin-voice-state
    custom-voice-slot: false

    process-fn: :pm101-plugin-process
    output-fn: :pm101-plugin-output
    note-on-fn: :pm101-plugin-note-on
    note-off-fn: :pm101-plugin-note-off

    param-info-fn: :pm101-plugin-param-info
    get-param-fn: :pm101-plugin-get-param
    set-param-fn: :pm101-plugin-set-param

    state-subsystem: PM101_STATE_MAGIC
    state-version: PM101_STATE_SCHEMA
    state-save-ascii: false

    save-state-fn: :pm101-plugin-save
    load-state-fn: :pm101-plugin-load

    factory-count: PM101-FACTORY-PRESET-COUNT
    factory-preset-fn: :pm101-factory-preset
]

pm101-state-load: func [
    "C-ABI entry point the VST3 shell calls to load session/preset state, through the shared BROM dispatcher."
    #export
    :core [c-pointer!] "Borrowed mutable engine instance."
    bytes [c-pointer!] "Borrowed source bytes."
    size [size!] "Available source byte count."
    return: [logic!] "True when the blob was recognized and applied."
] [return brom-state-load :pm101-brom-engine :core bytes size]

pm101-state-save: func [
    "C-ABI entry point the VST3 shell calls to save session/preset state, through the shared BROM dispatcher."
    #export
    :core [c-pointer!] "Borrowed engine instance the values are read from."
    out [c-pointer!] "Caller-owned destination bytes."
    capacity [size!] "Destination capacity."
    return: [logic!] "True when the state fitted and was written."
] [return brom-state-save :pm101-brom-engine :core out capacity]

; --- the factory bank, as the host formats see it -----------------------------

pm101-get-factory-preset-count: func [
    "Return the number of built-in PM-101 presets."
    #export
    return: [u32!] "Factory-bank size."
] [return as u32! preset-factory-count :pm101-brom-engine]

pm101-factory-preset-name: func [
    "Copy one factory preset's display name into caller-owned bytes."
    #export
    index [u32!] "Zero-based factory-bank index."
    out [c-pointer!] "Caller-owned destination bytes."
    capacity [u32!] "Destination capacity including the terminator."
    return: [logic!] "True when the name fitted."
] [
    name: preset-factory-name :pm101-brom-engine (as i32! index)
    return preset-fill-buffer :name :out (as i32! capacity)
]

pm101-factory-preset-key: func [
    "Copy one factory preset's stable key into caller-owned bytes."
    #export
    index [u32!] "Zero-based factory-bank index."
    out [c-pointer!] "Caller-owned destination bytes."
    capacity [u32!] "Destination capacity including the terminator."
    return: [logic!] "True when the key fitted."
] [
    key: preset-factory-key :pm101-brom-engine (as i32! index)
    return preset-fill-buffer :key :out (as i32! capacity)
]

pm101-factory-preset-values: func [
    "Materialize one complete factory preset into caller-owned f64 values."
    #export
    index [u32!] "Zero-based factory-bank index."
    out [c-pointer!] "Caller-owned f64 array."
    capacity [u32!] "Number of f64 slots available."
    return: [logic!] "True when the canonical snapshot was copied."
] [
    if any [none? out capacity < (as u32! PM101_PARAM_COUNT)] [return false]
    snapshot: make [#mutable preset-snapshot!] [count: 0 index: -1 values: []]
    if not preset-factory-materialize :pm101-brom-engine (as i32! index)
        (addr-of snapshot) [return false]
    unsafe/memcpy out (addr-of snapshot/values) (PM101_PARAM_COUNT * 8)
    return true
]
