Recoil [
    Title: "Shared CLAP shell"
    Description: {
        The host half of a CLAP plug-in, written once. Everything here is glue
        that talks to the host and nothing here knows what the plug-in sounds
        like: event dispatch, audio and note ports, the parameter extension,
        state streaming, GUI lifecycle, the factory and the entry point.

        A plug-in supplies a brom/plugin/engine descriptor and this module
        drives it. Before Brom, kapralova/clap/clap_entry.rcl (1670 lines) and
        loos/clap/clap_entry.rcl (1762) held two copies of this file that
        differed by 294 lines out of 3,432 -- and every one of those 294 lines
        was a parameter table, a voice count or a plug-in name.

        The engine is registered rather than linked: a plug-in's own entry
        calls brom-clap-register-engine from the CLAP entry init hook, which
        the host always calls before it asks for the factory.
    }
    Type: module
    Module: brom/plugin/clap/entry
    Ffi: [c-string]
    Imports: [
        brom/plugin/values [param-range!]
        brom/plugin/engine [
            engine! param-info! brom-voice-state!
            BROM-MAX-VOICES BROM-MAX-PARAMS BROM-MAX-STATE-BYTES
            engine-param-info brom-select-voice
        ]
        brom/plugin/preset [
            preset-cstr-string preset-fill-buffer
            preset-dir preset-ensure-dir
            preset-name-of preset-key-of preset-description-of
            preset-feature-count preset-feature-at
            preset-factory-count preset-factory-text preset-factory-name
            preset-factory-key preset-factory-index-by-key
            preset-factory-materialize preset-snapshot-apply preset-factory-match
        ]
        brom/plugin/preset/schema [brom-preset-schema-read brom-preset-prepare-text]
        brom/plugin/state/dispatch [brom-state-load brom-state-save brom-state-save-context]
        std/string [starts-with]
    ]
    Exports: [
        brom-clap-init-engine
        brom-clap-plugin-factory
        brom-clap-entry-init brom-clap-entry-deinit
    ]
]

math-ffi: foreign <math.h> [
    pow: "pow" [f64! f64!] return: [f64!]
]

stdio-ffi: foreign <stdio.h> [
    snprintf-f64: "snprintf" [c-pointer! i32! c-string! f64! return: [i32!]]
]

stdlib-ffi: foreign <stdlib.h> [
    strtod: "strtod" [c-string! c-pointer! return: [f64!]]
]

string-ffi: foreign <string.h> [
    strcmp: "strcmp" [c-string! c-string!] return: [i32!]
]

