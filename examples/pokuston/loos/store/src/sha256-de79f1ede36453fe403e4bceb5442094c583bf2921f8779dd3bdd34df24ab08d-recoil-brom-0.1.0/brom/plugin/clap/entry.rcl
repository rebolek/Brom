CLAP_VERSION_MAJOR: 1
CLAP_VERSION_MINOR: 2
CLAP_VERSION_REVISION: 7
CLAP_NAME_SIZE: 256
CLAP_PATH_SIZE: 1024

CLAP_CORE_EVENT_SPACE_ID: 0
CLAP_EVENT_NOTE_ON: 0
CLAP_EVENT_NOTE_OFF: 1
CLAP_EVENT_NOTE_CHOKE: 2
CLAP_EVENT_PARAM_VALUE: 5
CLAP_EVENT_PARAM_GESTURE_BEGIN: 7
CLAP_EVENT_PARAM_GESTURE_END: 8

CLAP_PROCESS_CONTINUE: 1
CLAP_PROCESS_ERROR: 0

CLAP_AUDIO_PORT_IS_MAIN: 1
CLAP_INVALID_ID: as u32! 4294967295
CLAP_NOTE_DIALECT_CLAP: 1
CLAP_PRESET_DISCOVERY_LOCATION_FILE: 0
CLAP_PRESET_DISCOVERY_LOCATION_PLUGIN: 1
CLAP_PARAM_IS_AUTOMATABLE: 32
CLAP_PARAM_FLAGS: CLAP_PARAM_IS_AUTOMATABLE
CLAP_PARAM_RESCAN_VALUES: 1
CLAP_PORT_STEREO: as c-string! "stereo"

CLAP_EXT_AUDIO_PORTS: as c-string! "clap.audio-ports"
CLAP_EXT_NOTE_PORTS: as c-string! "clap.note-ports"
CLAP_EXT_PARAMS: as c-string! "clap.params"
CLAP_EXT_STATE: as c-string! "clap.state"
CLAP_EXT_GUI: as c-string! "clap.gui"
CLAP_EXT_TIMER_SUPPORT: as c-string! "clap.timer-support"
CLAP_EXT_PRESET_LOAD: as c-string! "clap.preset-load/2"
CLAP_EXT_PRESET_LOAD_COMPAT: as c-string! "clap.preset-load.draft/2"
CLAP_EXT_STATE_CONTEXT: as c-string! "clap.state-context/2"
CLAP_STATE_CONTEXT_FOR_PRESET: 1
CLAP_STATE_CONTEXT_FOR_DUPLICATE: 2
CLAP_STATE_CONTEXT_FOR_PROJECT: 3
CLAP_PLUGIN_FACTORY_ID: as c-string! "clap.plugin-factory"
CLAP_PRESET_DISCOVERY_FACTORY_ID: as c-string! "clap.preset-discovery-factory/2"
CLAP_PRESET_DISCOVERY_FACTORY_ID_COMPAT: as c-string! "clap.preset-discovery-factory/draft-2"

#extern c-array! [c-string! 3] recoil_clap_features_list

; The plug-in's descriptor, reached by symbol rather than by registration.
;
; A registration call cannot work here: in a --lib build (which this always is,
; because a CLAP host reads clap_entry as static data straight after dlopen)
; module-level *assignments* are hoisted into __recoil_init_globals but a bare
; module-level *call* is main-body code, and no main() is emitted -- so the call
; is silently dropped and the engine would stay null.
;
; So the contract is a fixed symbol: every plug-in defines
;
;     #export [brom-engine-ptr]
;     brom-engine-ptr: make c-pointer! addr-of brom-engine
;
; and this shell links against that pointer. It is a c-pointer! rather than the
; engine! itself because #extern only accepts builtin types and c-array!
; (src/parser/rules/statements.r3:316) -- a user-defined c-struct! does not match
; the rule, falls through, and is rejected as a statement with no effect.
;
; The indirection costs nothing: both are module-level assignments hoisted into
; __recoil_init_globals, and addr-of a global is a link-time constant.
#extern c-pointer! brom_engine_ptr

; Returns the raw pointer rather than an engine! so callers can build a
; field-access view over it. A by-value engine! return would copy the whole
; vtable -- and retain/release every fn-ptr! field's env -- on each call, which
; several of these call sites make per audio block.
active-engine: func [
    "Address of the registered engine descriptor."
    return: [c-pointer!] "Borrowed; undefined before registration."
] [
    return brom_engine_ptr
]

number-ws-chars: make bitset! charset " ^(09)^(0A)^(0D)"
number-digit-chars: make bitset! charset "0123456789"
number-ws: make rule! [any number-ws-chars]
number-digits: make rule! [some number-digit-chars]
number-text: make rule! [
    number-ws
    opt ["+" | "-"]
    [
        [number-digits opt ["." any number-digit-chars]]
        | ["." number-digits]
    ]
    opt [["e" | "E"] opt ["+" | "-"] number-digits]
    number-ws
]

clap-version!: make c-struct! [
    major: [u32!]
    minor: [u32!]
    revision: [u32!]
]

clap-plugin-descriptor!: make c-struct! [
    clap_version: [clap-version!]
    id: [c-string!]
    name: [c-string!]
    vendor: [c-string!]
    url: [c-string!]
    manual_url: [c-string!]
    support_url: [c-string!]
    version: [c-string!]
    description: [c-string!]
    features: [c-pointer!]
]

clap-host!: make c-struct! [
    clap_version: [clap-version!]
    host_data: [c-pointer!]
    name: [c-string!]
    vendor: [c-string!]
    url: [c-string!]
    version: [c-string!]
    get_extension: [c-fn! [:clap-host! c-string!] return: [c-pointer!]]
    request_restart: [c-fn! [:clap-host!] return: [none!]]
    request_process: [c-fn! [:clap-host!] return: [none!]]
    request_callback: [c-fn! [:clap-host!] return: [none!]]
]

clap-host-timer-support!: make c-struct! [
    register_timer: [c-fn! [:clap-host! u32! c-pointer!] return: [logic!]]
    unregister_timer: [c-fn! [:clap-host! u32!] return: [logic!]]
]

clap-host-params!: make c-struct! [
    rescan: [c-fn! [:clap-host! u32!] return: [none!]]
    clear: [c-fn! [:clap-host! u32! u32!] return: [none!]]
    request_flush: [c-fn! [:clap-host!] return: [none!]]
]

clap-host-preset-load!: make c-struct! [
    on_error: [c-fn! [:clap-host! u32! c-string! c-string! i32! c-string!] return: [none!]]
    loaded: [c-fn! [:clap-host! u32! c-string! c-string!] return: [none!]]
]

clap-plugin!: make c-struct! [
    desc: [c-pointer!]
    plugin_data: [c-pointer!]
    init: [c-fn! [:clap-plugin!] return: [logic!]]
    destroy: [c-fn! [:clap-plugin!] return: [none!]]
    activate: [c-fn! [:clap-plugin! f64! i32! i32!] return: [logic!]]
    deactivate: [c-fn! [:clap-plugin!] return: [none!]]
    start_processing: [c-fn! [:clap-plugin!] return: [logic!]]
    stop_processing: [c-fn! [:clap-plugin!] return: [none!]]
    reset: [c-fn! [:clap-plugin!] return: [none!]]
    process: [c-fn! [:clap-plugin! :clap-process!] return: [i32!]]
    get_extension: [c-fn! [:clap-plugin! c-string!] return: [c-pointer!]]
    on_main_thread: [c-fn! [:clap-plugin!] return: [none!]]
]

clap-plugin-factory!: make c-struct! [
    get_plugin_count: [c-fn! [:clap-plugin-factory!] return: [i32!]]
    get_plugin_descriptor: [c-fn! [:clap-plugin-factory! u32!] return: [c-pointer!]]
    create_plugin: [c-fn! [:clap-plugin-factory! :clap-host! c-string!] return: [c-pointer!]]
]

clap-plugin-entry!: make c-struct! [
    clap_version: [clap-version!]
    init: [c-fn! [c-string!] return: [logic!]]
    deinit: [c-fn! [] return: [none!]]
    get_factory: [c-fn! [c-string!] return: [c-pointer!]]
]

clap-event-header!: make c-struct! [
