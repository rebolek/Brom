gui-show: func [:plugin [clap-plugin!] return: [logic!]] [
    gui-state: make c-pointer! plugin-gui-state-ptr-trimmed :plugin
    if none? gui-state [return false]
    state: make [#mutable recoil-clap-gui-backend-state!] as recoil-clap-gui-backend-state! gui-state
    if none? state/controller [return false]
    return helpers/gui-show state/controller
]

gui-hide: func [:plugin [clap-plugin!] return: [logic!]] [
    gui-state: make c-pointer! plugin-gui-state-ptr-trimmed :plugin
    if none? gui-state [return true]
    state: make [#mutable recoil-clap-gui-backend-state!] as recoil-clap-gui-backend-state! gui-state
    if none? state/controller [return true]
    return helpers/gui-hide state/controller
]

plugin-on-timer: func [:plugin [clap-plugin!] timer-id [u32!]] [
    gui-state: make c-pointer! plugin-gui-state-ptr-trimmed :plugin
    if none? gui-state [return none]
    state: make [#mutable recoil-clap-gui-backend-state!] as recoil-clap-gui-backend-state! gui-state
    if not none? state/controller [helpers/gui-on-timer state/controller timer-id]
]

plugin-on-timer-cb: callback plugin-on-timer [:plugin [clap-plugin!] timer-id [u32!]]

s_timer_support: make clap-plugin-timer-support! [on_timer: plugin-on-timer-cb]

