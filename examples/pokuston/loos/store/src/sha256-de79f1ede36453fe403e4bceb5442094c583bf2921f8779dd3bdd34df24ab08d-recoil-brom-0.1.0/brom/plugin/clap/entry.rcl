s_gui: make clap-plugin-gui! [
    is_api_supported: gui-is-api-supported-cb
    get_preferred_api: gui-get-preferred-api-cb
    create: gui-create-cb
    destroy: gui-destroy-cb
    set_scale: gui-set-scale-cb
    get_size: gui-get-size-cb
    can_resize: gui-can-resize-cb
    get_resize_hints: gui-get-resize-hints-cb
    adjust_size: gui-adjust-size-cb
    set_size: gui-set-size-cb
    set_parent: gui-set-parent-cb
    set_transient: gui-set-transient-cb
    suggest_title: gui-suggest-title-cb
    show: gui-show-cb
    hide: gui-hide-cb
]

plugin-get-extension: func [:plugin [clap-plugin!] id [c-string!] return: [c-pointer!]] [
    unused plugin
    if any [
        (string-ffi/strcmp id CLAP_EXT_PRESET_LOAD) = 0
        (string-ffi/strcmp id CLAP_EXT_PRESET_LOAD_COMPAT) = 0
    ] [
        eng0: make [#mutable engine!] as engine! active-engine
        if eng0/factory-count > 0 [return helpers/preset-load-extension]
    ]
    if (string-ffi/strcmp id CLAP_EXT_AUDIO_PORTS) = 0 [return addr-of s_audio_ports]
    if (string-ffi/strcmp id CLAP_EXT_NOTE_PORTS) = 0 [return addr-of s_note_ports]
    if (string-ffi/strcmp id CLAP_EXT_PARAMS) = 0 [return addr-of s_params]
    if (string-ffi/strcmp id CLAP_EXT_STATE) = 0 [return addr-of s_state]
    ; Withheld unless the engine opts in, the same way clap.gui is withheld
    ; without has-editor -- see CLAP_EXT_STATE_CONTEXT's own extension
    ; contract: implementing it without clap.state is invalid, and a plug-in
    ; that has not opted in should not advertise it either.
    if (string-ffi/strcmp id CLAP_EXT_STATE_CONTEXT) = 0 [
        eng-sc: make [#mutable engine!] as engine! active-engine
        if not eng-sc/has-state-context [return as c-pointer! none]
        return addr-of s_state_context
    ]
    ; Withheld rather than advertised-and-failing: a plug-in with no editor that
    ; still answers clap.gui leaves the host opening a window nothing draws.
    if (string-ffi/strcmp id CLAP_EXT_GUI) = 0 [
        eng: make [#mutable engine!] as engine! active-engine
        if not eng/has-editor [return as c-pointer! none]
        return addr-of s_gui
    ]
    if (string-ffi/strcmp id CLAP_EXT_TIMER_SUPPORT) = 0 [return addr-of s_timer_support]
    return as c-pointer! none
]

plugin-on-main-thread: func [:plugin [clap-plugin!]] [
    instance-raw: make c-pointer! plugin-instance-raw :plugin
    if not none? instance-raw [
        instance: make [#mutable brom-clap-instance!] as brom-clap-instance! instance-raw
        completions: as u32! helpers/preset-mailbox-take-completions instance/preset_mailbox
        if completions > 0 [
            helpers/preset-mailbox-reclaim instance/preset_mailbox
            request-host-param-rescan :instance-raw
            preset-index: make i32! helpers/preset-mailbox-current instance/preset_mailbox
            view: make [#mutable brom-preset-view!] none
            if all [instance/preset_load_pending
                preset-api/preset-read-view instance/preset_tx (addr-of view)] [
                key: preset-cstr-string (addr-of view/working_identity/key/0)
                location: either instance/preset_load_location_kind =
                    (as u32! CLAP_PRESET_DISCOVERY_LOCATION_FILE) [
                    addr-of instance/preset_load_location/0
                ] [as c-pointer! none]
                notify-host-preset-load :instance-raw
                    instance/preset_load_location_kind :location (as c-string! key) true
                instance/preset_load_pending: false
            ]
            ; And tell the editor, if there is one. It cannot ask: the commit
            ; runs on the audio thread, so an editor that polled the mailbox
            ; would read whatever was committed BEFORE the load it triggered.
            ; This is the first moment on the main thread at which the answer
            ; is true, which makes it the moment to push it.
            editor-gui: make c-pointer! plugin-gui-state-ptr-trimmed :plugin
            if not none? editor-gui [
                editor-state: make [#mutable recoil-clap-gui-backend-state!]
                    as recoil-clap-gui-backend-state! editor-gui
                if not none? editor-state/controller [
                    helpers/gui-preset-changed editor-state/controller
                        (either preset-index >= 0 [preset-index] [-1])
                ]
            ]
        ]
    ]
    gui-state: make c-pointer! plugin-gui-state-ptr-trimmed :plugin
    if none? gui-state [return none]
    state: make [#mutable recoil-clap-gui-backend-state!] as recoil-clap-gui-backend-state! gui-state
    if not none? state/controller [helpers/gui-on-main-thread state/controller]
]

plugin-get-extension-cb: callback plugin-get-extension [
    :plugin [clap-plugin!]
    id [c-string!]
    return: [c-pointer!]
]

plugin-on-main-thread-cb: callback plugin-on-main-thread [
    :plugin [clap-plugin!]
]

plugin-init-cb: callback plugin-init [:plugin [clap-plugin!] return: [logic!]]
plugin-destroy-cb: callback plugin-destroy [:plugin [clap-plugin!]]
plugin-activate-cb: callback plugin-activate [:plugin [clap-plugin!] sample-rate [f64!] min-frames [i32!] max-frames [i32!] return: [logic!]]
plugin-deactivate-cb: callback plugin-deactivate [:plugin [clap-plugin!]]
plugin-start-processing-cb: callback plugin-start-processing [:plugin [clap-plugin!] return: [logic!]]
plugin-stop-processing-cb: callback plugin-stop-processing [:plugin [clap-plugin!]]
plugin-reset-cb: callback plugin-reset [:plugin [clap-plugin!]]
plugin-process-cb: callback plugin-process [:plugin [clap-plugin!] :proc [clap-process!] return: [i32!]]

s_plugin: make clap-plugin! [
    desc: addr-of clap-descriptor
    plugin_data: none
    init: plugin-init-cb
    destroy: plugin-destroy-cb
    activate: plugin-activate-cb
    deactivate: plugin-deactivate-cb
    start_processing: plugin-start-processing-cb
    stop_processing: plugin-stop-processing-cb
    reset: plugin-reset-cb
    process: plugin-process-cb
    get_extension: plugin-get-extension-cb
    on_main_thread: plugin-on-main-thread-cb
]

create-plugin: func [
    "Allocate a plug-in instance if the host asked for this engine's id."
    :factory [clap-plugin-factory!] "Borrowed factory; unused."
    :host [clap-host!] "Borrowed host, retained on the instance."
    plugin-id [c-string!] "Plug-in id the host is requesting."
    return: [c-pointer!] "The clap_plugin pointer, or none on a miss."
] [
    unused factory
    if none? plugin-id [return as c-pointer! none]
    eng: make [#mutable engine!] as engine! active-engine
    if (string-ffi/strcmp plugin-id eng/id) <> 0 [return as c-pointer! none]
    instance-raw: make c-pointer! unsafe/malloc (size-of brom-clap-instance!)
    if none? instance-raw [return as c-pointer! none]
    unsafe/memset instance-raw 0 (size-of brom-clap-instance!)
    instance: make [#mutable brom-clap-instance!] as brom-clap-instance! instance-raw
    instance/plugin: s_plugin
    instance/plugin/plugin_data: as c-pointer! (addr-of instance/plugin)
    instance/host: as c-pointer! host
    instance/core: eng/create-fn
    if none? instance/core [
        unsafe/free instance-raw
        return as c-pointer! none
    ]
    instance/preset_mailbox: helpers/preset-mailbox-create
    if none? instance/preset_mailbox [
        eng/destroy-fn instance/core
        unsafe/free instance-raw
        return as c-pointer! none
    ]
    if not initialize-preset-transaction :instance :eng [
        helpers/preset-mailbox-destroy instance/preset_mailbox
        eng/destroy-fn instance/core
        unsafe/free instance-raw
        return as c-pointer! none
    ]
    repeat i BROM-MAX-VOICES [
        instance/voice_active/:i: false
        instance/voice_note_ids/:i: -1
        instance/voice_port_indexes/:i: -1
        instance/voice_channels/:i: -1
        instance/voice_keys/:i: -1
    ]
    unsafe/memset (addr-of instance/gui) 0 (size-of recoil-clap-gui-backend-state!)
    return addr-of instance/plugin
]

factory-get-plugin-count: func [:factory [clap-plugin-factory!] return: [i32!]] [
    unused factory
    1
]

factory-get-plugin-descriptor: func [
    :factory [clap-plugin-factory!]
    index [u32!]
    return: [c-pointer!]
] [
    unused factory
    either index = 0 [addr-of clap-descriptor] [none]
]

factory-create-plugin: func [
    :factory [clap-plugin-factory!]
    :host [clap-host!]
    plugin-id [c-string!]
    return: [c-pointer!]
] [
    create-plugin :factory :host plugin-id
]

factory-get-plugin-count-cb: callback factory-get-plugin-count [
    :factory [clap-plugin-factory!]
    return: [i32!]
]

factory-get-plugin-descriptor-cb: callback factory-get-plugin-descriptor [
    :factory [clap-plugin-factory!]
    index [u32!]
    return: [c-pointer!]
]

factory-create-plugin-cb: callback factory-create-plugin [
    :factory [clap-plugin-factory!]
    :host [clap-host!]
    plugin-id [c-string!]
    return: [c-pointer!]
]

s_factory: make clap-plugin-factory! [
    get_plugin_count: factory-get-plugin-count-cb
    get_plugin_descriptor: factory-get-plugin-descriptor-cb
    create_plugin: factory-create-plugin-cb
]

entry-init: func [plugin-path [c-string!] return: [logic!]] [
    unused plugin-path
    ; Refusing here is the whole point of the ceilings: a host that gets false
    ; from init unloads the plug-in instead of running it against tables too
    ; small for the engine it linked.
    ready: make logic! brom-clap-init-engine
    return ready
]

entry-deinit: func [] [
]

entry-get-factory: func [factory-id [c-string!] return: [c-pointer!]] [
    if none? factory-id [return as c-pointer! none]
    if (string-ffi/strcmp factory-id CLAP_PLUGIN_FACTORY_ID) = 0 [return addr-of s_factory]
    if any [
        (string-ffi/strcmp factory-id CLAP_PRESET_DISCOVERY_FACTORY_ID) = 0
        (string-ffi/strcmp factory-id CLAP_PRESET_DISCOVERY_FACTORY_ID_COMPAT) = 0
    ] [
        eng: make [#mutable engine!] as engine! active-engine
        if eng/factory-count > 0 [return helpers/preset-discovery-factory]
    ]
    return as c-pointer! none
]

entry-init-cb: callback entry-init [
    plugin-path [c-string!]
    return: [logic!]
]

entry-deinit-cb: callback entry-deinit []

entry-get-factory-cb: callback entry-get-factory [
    factory-id [c-string!]
    return: [c-pointer!]
]

#export [clap-entry]
clap-entry: make clap-plugin-entry! [
    clap_version: clap-version-init
    init: entry-init-cb
    deinit: entry-deinit-cb
    get_factory: entry-get-factory-cb
]
