    param_id: [u32!]
]

clap-audio-buffer!: make c-struct! [
    data32: [c-pointer!]
    data64: [c-pointer!]
    channel_count: [u32!]
    latency: [u32!]
    constant_mask: [u64!]
]

clap-input-events!: make c-struct! [
    ctx: [c-pointer!]
    size: [c-fn! [:clap-input-events!] return: [u32!]]
    get: [c-fn! [:clap-input-events! u32!] return: [c-pointer!]]
]

clap-output-events!: make c-struct! [
    ctx: [c-pointer!]
    try_push: [c-fn! [:clap-output-events! :clap-event-header!] return: [logic!]]
]

clap-process!: make c-struct! [
    steady_time: [i64!]
    frames_count: [u32!]
    transport: [c-pointer!]
    audio_inputs: [c-pointer!]
    audio_outputs: [c-pointer!]
    audio_inputs_count: [u32!]
    audio_outputs_count: [u32!]
